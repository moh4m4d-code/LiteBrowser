<Window x:Class="LiteBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lite Browser" Width="1200" Height="780" Background="#18181C"
        Loaded="Window_Loaded" PreviewKeyDown="Window_KeyDown">
  <Window.Resources>
    <Style x:Key="IconBtn" TargetType="Button">
      <Setter Property="Foreground" Value="#D8D8E0"/>
      <Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/>
      <Setter Property="FontSize" Value="16"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="8" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#33343C"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="38"/><RowDefinition Height="46"/><RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#101013" Padding="8,4,8,0">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Width="30" Height="28"
                Content="+" FontSize="18" Click="NewTab_Click" ToolTip="New tab (Ctrl+T)"/>
        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
          <StackPanel x:Name="TabStrip" Orientation="Horizontal"/>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Border Grid.Row="1" Background="#202025" Padding="8,6">
      <DockPanel>
        <Button x:Name="BackBtn" Style="{StaticResource IconBtn}" Content="←" Click="Back_Click" IsEnabled="False"/>
        <Button x:Name="FwdBtn" Style="{StaticResource IconBtn}" Content="→" Click="Fwd_Click" IsEnabled="False"/>
        <Button Style="{StaticResource IconBtn}" Content="⟳" Click="Reload_Click" ToolTip="Reload (F5)"/>
        <Border Background="#2C2C33" CornerRadius="17" Margin="8,0,0,0" Padding="14,0">
          <TextBox x:Name="Address" Background="Transparent" BorderThickness="0" Foreground="#F0F0F5"
                   CaretBrush="#8FA8FF" FontSize="14" VerticalContentAlignment="Center"
                   KeyDown="Address_KeyDown" GotKeyboardFocus="Address_Focus"/>
        </Border>
      </DockPanel>
    </Border>

    <Grid x:Name="Host" Grid.Row="2" Background="#18181C"/>
  </Grid>
</Window>
